FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*

# PyTorch build to install: "cpu" (default, small) or a CUDA build such as "cu128"
# (needed for Blackwell / RTX 50-series). docker-compose.gpu.yml sets cu128.
ARG TORCH_VARIANT=cpu
RUN pip install --no-cache-dir --timeout=300 --retries=5 \
        --index-url https://download.pytorch.org/whl/${TORCH_VARIANT} torch torchvision

COPY requirements-worker.txt /app/requirements-worker.txt
RUN pip install --no-cache-dir --timeout=180 --retries=5 -r /app/requirements-worker.txt

COPY worker /app/worker

CMD ["python", "worker/worker.py"]
