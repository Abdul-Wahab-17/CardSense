# CardSense .env — copy to .env and fill in your values.
# Lines starting with # are comments. Defaults in compose work without these
# being set, but the LLM block below is required for Tipsi / explanations.

# ---- Auth ------------------------------------------------------------
# 1 (default): sign in on the main page; the Blackjack page reuses that session.
# 0: no login needed, handy for a private demo on your own machine.
# AUTH_ENABLED=1

# ---- Postgres (optional; SQLite fallback works without these) -------
# DATABASE_URL=postgresql://cardsense:cardsense@db:5432/cardsense
# POSTGRES_HOST_PORT=5433

# ---- LLM advisor (OpenRouter) ---------------------------------------
LLM_ENABLED=1
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-replace-with-your-key
LLM_MODEL=anthropic/claude-sonnet-4.6
LLM_TIMEOUT_SEC=8.0
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=300

# ---- Worker tuning --------------------------------------------------
# CONF_THRES=0.03                # lower = catch more, more false positives
# WORKER_PROCESSES=1
# SLOW_ACCURATE_MODE=1

# ---- Camera / edge client (only used if start.sh launches edge_camera_client.py)
# CAMERA_ID=cam-1
# CAMERA_SOURCE=0
# CAMERA_FPS=10
