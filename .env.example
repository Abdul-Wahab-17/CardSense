REDIS_URL=redis://redis:6379/0
FRAME_STREAM=frames
DETECTION_STREAM=detections
FRAME_CONSUMER_GROUP=yolo_workers
WORKER_PROCESSES=1
YOLO_MODEL=playing-cards-auto.pt
YOLO_MODEL_URL=https://huggingface.co/shrimantasatpati/yolov11_playing_cards_detection/resolve/main/detect/yolo11n_playing_cards/weights/best.pt,https://huggingface.co/mustafakemal0146/playing-cards-yolov8/resolve/main/playing_cards_model_0_playing-cards-colab.pt,https://raw.githubusercontent.com/noorkhokhar99/Playing-Cards-Detection-with-YoloV8/main/yolov8s_playing_cards.pt
MODEL_CACHE_DIR=/tmp/cardsense-models
CONF_THRES=0.03
DEBUG_CONF=0.001
MAX_FRAME_AGE_MS=2500
SLOW_ACCURATE_MODE=1
MAX_QUEUE_LEN=5000
WORKER_LOG_STREAM=worker_logs
WORKER_STATUS_PREFIX=worker:status
WORKER_HEARTBEAT_SEC=5
MODEL_SMOKE_TEST_URLS=https://huggingface.co/mustafakemal0146/playing-cards-yolov8/resolve/main/1.png,https://huggingface.co/mustafakemal0146/playing-cards-yolov8/resolve/main/2.png,https://huggingface.co/mustafakemal0146/playing-cards-yolov8/resolve/main/3.png
MODEL_SMOKE_MIN_DETECTIONS=1
HAND_SIZE=13
MIN_CARD_CONF=0.02
HAND_MEMORY_EVENTS=400
MIN_CARD_VOTES=1
CARD_LABELS=AC,AD,AH,AS,KC,KD,KH,KS,QC,QD,QH,QS,JC,JD,JH,JS,10C,10D,10H,10S,9C,9D,9H,9S,8C,8D,8H,8S,7C,7D,7H,7S,6C,6D,6H,6S,5C,5D,5H,5S,4C,4D,4H,4S,3C,3D,3H,3S,2C,2D,2H,2S

# Production-grade settings
APP_ROLE=all
WORKER_ENABLED=1
REDUCER_LOCK_TTL_SEC=5
REDUCER_LOCK_RETRY_MS=20
REDUCER_BATCH_SIZE=50
REDUCER_MAX_EVENT_LAG_MS=2000

DATABASE_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=3000

AUTH_ENABLED=1
JWT_ISSUER=
JWT_AUDIENCE=
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_HS256_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_SEC=1800
REFRESH_TOKEN_TTL_SEC=2592000
API_KEY_HASHES=
ADMIN_ROLE_NAME=admin
OPERATOR_ROLE_NAME=operator
CORS_ALLOWED_ORIGINS=*

STORE_RAW_FRAMES=0
FRAME_RETENTION_DAYS=0
EVENT_RETENTION_DAYS=30
RECOMMENDATION_RETENTION_DAYS=30
PII_REDACTION_ENABLED=1

METRICS_ENABLED=1
METRICS_NAMESPACE=cardsense
TRACE_ENABLED=0
TRACE_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
LOG_JSON=1

WORKER_AUTOSCALE_MIN=1
WORKER_AUTOSCALE_MAX=4
TARGET_QUEUE_DEPTH_PER_WORKER=200
FRAME_INGEST_RATE_LIMIT_FPS=8
WS_BROADCAST_BATCH_SIZE=64

DEPLOY_ENV=dev
RELEASE_VERSION=dev-local
CANARY_PERCENT=0

FEATURE_CALIBRATED_SEAT_MAPPING=1
FEATURE_STRICT_TRANSITION_REJECT=1
FEATURE_POLICY_SIMULATOR_V2=1
FEATURE_BELIEF_BAYES_UPDATE=1
FEATURE_DB_EVENT_PERSISTENCE=1
FEATURE_REPLAY_API=1
FEATURE_ENFORCE_CAMERA_BINDING=1
PERSIST_RECOMMENDATION_ON_TRANSITION=1

# Variant / reconciliation
HAND_OCCLUSION_TTL_MS=2000
TABLE_OCCLUSION_TTL_MS=1200
HAND_TO_TABLE_GRACE_MS=1200
MAX_TRANSITION_GAP_MS=3000
MAX_TABLE_GROWTH_PER_EVENT=1
ALLOW_WON_PILE_REPLAY=0

# Production auth/session hardening
AUTH_STRICT_ISS_AUD=1
AUTH_ENFORCE_JTI=1
AUTH_PROD_SECRET_REQUIRED=1

# Camera readiness / recommendation safety
CAMERA_STALE_THRESHOLD_MS=5000

# Multi-machine model registry
MODEL_PROVIDER=filesystem
MODEL_REF_HAND=
MODEL_REF_TABLE=
MODEL_REGISTRY_URL=
MODEL_REGISTRY_TOKEN=
MODEL_SHA256_HAND=
MODEL_SHA256_TABLE=
WORKER_SUPPORTS_HAND=1
WORKER_SUPPORTS_TABLE=1
