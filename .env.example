REDIS_URL=redis://redis:6379/0
FRAME_STREAM=frames
DETECTION_STREAM=detections
FRAME_CONSUMER_GROUP=yolo_workers
WORKER_PROCESSES=1
YOLO_MODEL=/app/models/playing_cards_best.pt
YOLO_MODEL_URL=https://raw.githubusercontent.com/noorkhokhar99/Playing-Cards-Detection-with-YoloV8/main/yolov8s_playing_cards.pt
MODEL_CACHE_DIR=/tmp/cardsense-models
CONF_THRES=0.02
DEBUG_CONF=0.001
MAX_FRAME_AGE_MS=2500
SLOW_ACCURATE_MODE=1
MAX_QUEUE_LEN=5000
HAND_SIZE=13
MIN_CARD_CONF=0.02
HAND_MEMORY_EVENTS=400
MIN_CARD_VOTES=1
CARD_LABELS=
